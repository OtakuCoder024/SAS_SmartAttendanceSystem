<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="0dp"
    android:background="@drawable/samplebg"
    tools:context=".Register">

    <TextView
        android:id="@+id/textView14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView15"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="650dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/textviews"
        android:backgroundTint="#BFFFFFFF"
        android:foregroundGravity="center"
        app:layout_constraintBottom_toTopOf="@+id/textView15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView14">

        <EditText
            android:id="@+id/nameR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Full Name"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.505"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/idR" />

        <Spinner
            android:id="@+id/sectionR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Course &amp; Section"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.494"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nameR" />

        <EditText
            android:id="@+id/numR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Tel Num"
            android:inputType="number"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sectionR" />

        <EditText
            android:id="@+id/dobR"
            android:layout_width="130dp"
            android:layout_height="38dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:clickable="true"
            android:ems="10"
            android:focusable="false"
            android:hint="Birthdate"
            android:inputType="none"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toStartOf="@+id/ageR"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/numR" />

        <EditText
            android:id="@+id/ageR"
            android:layout_width="50dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Age"
            android:inputType="number"
            android:paddingLeft="10dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toStartOf="@+id/sexR"
            app:layout_constraintStart_toEndOf="@+id/dobR"
            app:layout_constraintTop_toBottomOf="@+id/numR" />

        <EditText
            android:id="@+id/sexR"
            android:layout_width="70dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Sex"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ageR"
            app:layout_constraintTop_toBottomOf="@+id/numR" />

        <EditText
            android:id="@+id/emailR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.505"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dobR" />

        <EditText
            android:id="@+id/conpassR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/passR" />

        <EditText
            android:id="@+id/passR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailR" />

        <Button
            android:id="@+id/signupButton"
            android:layout_width="111dp"
            android:layout_height="27dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/textviews"
            android:backgroundTint="#FF9800"
            android:text="Register"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/conpassR" />

        <TextView
            android:id="@+id/toLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Already have an account? Log In"
            android:textColor="#E1000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/signupButton" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Register"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/idR"
            android:layout_width="276dp"
            android:layout_height="38dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/textviews"
            android:ems="10"
            android:hint="Student ID"
            android:inputType="number"
            android:paddingLeft="10dp"
            android:textColor="#000000"
            android:textColorHint="#B1AEAE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.494"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView7" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>